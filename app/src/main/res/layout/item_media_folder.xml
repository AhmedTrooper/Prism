<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_folder_height"
    android:background="@drawable/bg_row_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <!-- Folder Row Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Folder Icon -->
        <ImageView
            android:id="@+id/folderIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Folder"
            android:src="@drawable/ic_mx_folder" />

        <!-- Folder Name & Video Count (Single Line, Never Wraps) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folderNameTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="Camera" />

            <TextView
                android:id="@+id/videoCountTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_body"
                tools:text="(27)" />

            <!-- NEW Badge -->
            <TextView
                android:id="@+id/newBadgeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_mx_new"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="NEW"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline Divider with standard MX 72dp indentation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="72dp"
        android:background="@color/mx_divider_subtle" />

</RelativeLayout>
