<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <FrameLayout
        android:id="@+id/streamsAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elevation_appbar">

        <!-- Normal Bar Layout -->
        <LinearLayout
            android:id="@+id/normalBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_8">

            <!-- Back Arrow (Visible inside subcategories) -->
            <ImageButton
                android:id="@+id/navBackBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_arrow_back_24dp"
                app:tint="?android:attr/textColorPrimary"
                tools:visibility="visible" />

            <!-- Title -->
            <TextView
                android:id="@+id/streamsTitleTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Streams"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Add Category / Stream Button -->
            <ImageButton
                android:id="@+id/addBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add Folder or Stream"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_add_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <!-- Search Action -->
            <ImageButton
                android:id="@+id/searchBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_search_24dp"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Search Mode Bar -->
        <LinearLayout
            android:id="@+id/searchBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_8"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/closeSearchBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close search"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_arrow_back_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search streams or folders..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="@color/mx_text_secondary_theme"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/clearSearchTextBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_close_white_24dp"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView for Categories & Videos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/streamsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="72dp"
            android:scrollbars="vertical" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_32"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.3"
                android:contentDescription="Empty"
                app:srcCompat="@drawable/ic_mx_bottom_streams"
                app:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/emptyMessageTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center"
                android:text="No streams or folders yet.\nTap + to add a category or video stream."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyAddBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="+ Add Stream or Folder"
                android:textColor="@color/mx_blue"
                app:strokeColor="@color/mx_blue" />
        </LinearLayout>

        <!-- Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginBottom="80dp"
            android:contentDescription="Add Category or Stream"
            app:backgroundTint="@color/mx_blue"
            app:srcCompat="@drawable/ic_add_24dp"
            app:tint="@android:color/white" />
    </FrameLayout>
</LinearLayout>
