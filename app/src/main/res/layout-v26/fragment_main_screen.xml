<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Authentic MX Player Action Bar -->
    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="?android:attr/colorBackground"
        android:elevation="@dimen/elevation_appbar">

        <!-- Normal Title Bar -->
        <LinearLayout
            android:id="@+id/normalBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_8">

            <!-- Back Arrow (Visible inside folders) -->
            <ImageButton
                android:id="@+id/navBackBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:tooltipText="Back"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_arrow_back_24dp"
                app:tint="?android:attr/textColorPrimary"
                tools:visibility="visible" />

            <!-- Title Layout -->
            <TextView
                android:id="@+id/appTitleTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Folders"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/folderCountSubtitleTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="" />

            <!-- Folder All Mode Action -->
            <ImageButton
                android:id="@+id/folderAllBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="All Videos"
                android:tooltipText="All Videos"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_folder_all_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <!-- Search Action -->
            <ImageButton
                android:id="@+id/searchBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:tooltipText="Search"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_search_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <!-- View Mode Switch (Grid vs List Layout) -->
            <ImageButton
                android:id="@+id/viewModeBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle View Mode"
                android:tooltipText="Toggle view"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_mx_layout_switcher"
                app:tint="?android:attr/textColorPrimary" />

            <!-- Refresh Media Library -->
            <ImageButton
                android:id="@+id/refreshBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="12dp"
                android:tooltipText="Refresh"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_refresh_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <!-- Overflow 3-Dots Menu -->
            <ImageButton
                android:id="@+id/moreMenuBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="12dp"
                android:tooltipText="More options"
                app:srcCompat="@drawable/ic_more_vert_24dp"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- Search Mode Bar -->
        <LinearLayout
            android:id="@+id/searchBarLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_8"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageButton
                android:id="@+id/closeSearchBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close search"
                android:tooltipText="Close search"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_arrow_back_24dp"
                app:tint="?android:attr/textColorPrimary" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search videos or folders..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="@color/mx_text_secondary_theme"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/clearSearchTextBtn"
                style="?buttonBarButtonStyle"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:tooltipText="Clear"
                android:padding="12dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_close_white_24dp"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Media List / Folder List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mediaRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_8"
            android:paddingBottom="@dimen/spacing_8"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_media_folder" />

        <!-- Empty State Message -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.45"
                android:contentDescription="Empty"
                app:srcCompat="@drawable/ic_prism_splash_logo" />

            <TextView
                android:id="@+id/emptyMessageTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_no_videos"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Prism Branded Loading / Searching Indicator -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/loadingLogo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/ic_prism_splash_logo" />

            <ProgressBar
                android:id="@+id/loadingProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/mx_blue" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                tools:text="@string/loading_folder" />
        </LinearLayout>

        <!-- Storage Permission Required Card -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/spacing_24"
            android:background="@drawable/hud_background"
            android:elevation="@dimen/elevation_hud"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_24"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Permission"
                app:srcCompat="@drawable/ic_video_file_24dp"
                app:tint="@color/mx_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Storage Access Required"
                android:textColor="@color/mx_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Allow Prism access to your videos to browse and play your media library."
                android:textColor="@color/mx_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grantPermissionBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/badge_mx_new"
                android:backgroundTint="@color/mx_blue"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="Grant Access"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
