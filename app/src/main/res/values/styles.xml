<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="FilePickerTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="nnf_separator_color">@color/mx_blue</item>

        <!-- MX Player Clean Surface Theme -->
        <item name="colorPrimary">@color/mx_blue</item>
        <item name="colorPrimaryDark">@color/mx_window_bg</item>
        <item name="colorAccent">@color/mx_blue</item>
        <item name="android:colorBackground">@color/mx_window_bg</item>
        <item name="android:statusBarColor">@color/mx_window_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/mx_window_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Need to set this also to style create folder dialog -->
        <item name="alertDialogTheme">@style/FilePickerTheme.AlertDialog</item>
        <item name="android:textColorPrimary">@color/mx_text_primary_theme</item>
        <item name="android:textColorSecondary">@color/mx_text_secondary_theme</item>
        <item name="android:textColorLink">@color/mx_blue</item>
    </style>

    <style name="FilePickerThemeSpecial" parent="FilePickerTheme">
        <!-- used to draw behind navigation bar -->
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Theme for cold launch splash window -->
    <style name="Theme.Prism.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/prism_splash_window_bg</item>
        <item name="android:statusBarColor">#0B1120</item>
        <item name="android:navigationBarColor">#0B1120</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="FilePickerTheme.AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
    </style>

    <!-- theme for player UI - base for API 23+ (cutout mode added in values-v27) -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="colorPrimary">@color/mx_blue</item>
        <item name="colorPrimaryDark">@color/mx_blue_dark</item>
        <item name="colorAccent">@color/mx_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- theme for preferences -->
    <style name="AppTheme.Preference" parent="Theme.Material3.DayNight">
        <item name="toolbarStyle">@style/AppTheme.Toolbar.Style</item>
        <item name="alertDialogTheme">@style/AppTheme.Preference.AlertDialog</item>
    </style>

    <style name="AppTheme.Toolbar.Style" parent="Widget.Material3.Toolbar">
        <item name="android:background">?colorSurface</item>
    </style>

    <style name="AppTheme.Preference.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
    </style>


    <!-- Material3 Switches -->
    <style name="Preference.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material" tools:override="true">
        <item name="android:widgetLayout">@layout/material_preferences_switch</item>
    </style>
</resources>
