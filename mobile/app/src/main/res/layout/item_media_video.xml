<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_video_height"
    android:background="@drawable/bg_row_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16">

        <!-- 16:9 Video Thumbnail with MX Duration Badge and Resume Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="112dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/mx_surface_variant"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/mx_outline_variant"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Placeholder Icon -->
                <ImageView
                    android:id="@+id/videoPlaceholderIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:contentDescription="Video"
                    app:srcCompat="@drawable/ic_prism_splash_logo" />

                <!-- Video Thumbnail -->
                <ImageView
                    android:id="@+id/videoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Thumbnail"
                    android:scaleType="centerCrop" />

                <!-- NEW Badge on Thumbnail -->
                <TextView
                    android:id="@+id/videoNewBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:background="@drawable/badge_mx_new"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:text="NEW"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Duration Badge -->
                <TextView
                    android:id="@+id/videoDurationTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:background="@drawable/badge_duration"
                    android:paddingStart="4dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="1dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="14:28" />

                <!-- Resume Watch Progress Bar -->
                <ProgressBar
                    android:id="@+id/videoProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:max="100"
                    android:progress="45"
                    android:progressBackgroundTint="#50000000"
                    android:progressTint="@color/mx_blue"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Video Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/videoTitleTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="Inception.2010.1080p.BluRay.x264.mkv" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/videoResolutionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mx_blue"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="1080p" />

                <TextView
                    android:id="@+id/videoDetailsTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="@dimen/text_label"
                    tools:text="• 1.4 GB • Sep 22, 2026" />
            </LinearLayout>
        </LinearLayout>

        <!-- Video Item 3-Dots Menu -->
        <ImageButton
            android:id="@+id/videoMoreBtn"
            style="?buttonBarButtonStyle"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="@dimen/spacing_8"
            app:srcCompat="@drawable/ic_more_vert_24dp"
            app:tint="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- Hairline Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="142dp"
        android:background="@color/mx_divider_subtle" />

</RelativeLayout>
