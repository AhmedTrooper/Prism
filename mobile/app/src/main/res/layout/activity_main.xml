<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Main Content Container with Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/mainAppContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_container_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_hairline"
            android:background="@color/mx_divider_subtle" />

        <!-- MX Player Style Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Local -->
            <LinearLayout
                android:id="@+id/tabLocal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tabLocalIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Local"
                    app:srcCompat="@drawable/ic_folder_24dp"
                    app:tint="@color/mx_blue" />

                <TextView
                    android:id="@+id/tabLocalTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Local"
                    android:textColor="@color/mx_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: Streams -->
            <LinearLayout
                android:id="@+id/tabStreams"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tabStreamsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Streams"
                    app:srcCompat="@drawable/ic_mx_bottom_streams"
                    app:tint="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tabStreamsTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Streams"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 3: Me -->
            <LinearLayout
                android:id="@+id/tabMe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tabMeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Me"
                    app:srcCompat="@drawable/ic_mx_bottom_me"
                    app:tint="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tabMeTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Me"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Branded Splash Screen Overlay -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1120"
        android:clickable="true"
        android:focusable="true">

        <!-- Center Branding Stack -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_prism_splash_logo" />

            <TextView
                android:id="@+id/splash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.25"
                android:text="PRISM"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splash_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="HIGH PERFORMANCE VIDEO PLAYER"
                android:textColor="#7E8FA6"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/splash_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="32dp"
                android:indeterminate="true"
                android:indeterminateTint="#007AFF" />
        </LinearLayout>

        <!-- Bottom Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:text="Powered by libmpv &amp; FFmpeg"
            android:textColor="#475569"
            android:textSize="11sp" />
    </FrameLayout>
</FrameLayout>
